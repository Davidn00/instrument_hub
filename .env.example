APP_NAME=InstrumentHub
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
SMTP_STARTTLS=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://instrumenthub:instrumenthub@localhost:5432/instrumenthub
DATABASE_ECHO=false

WEBSOCKET_MAX_CONNECTIONS=100
