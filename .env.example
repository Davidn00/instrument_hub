APP_NAME=InstrumentHub
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Local Docker Compose ports (change only when the host port is already occupied)
FRONTEND_PORT=8080
API_PORT=8200
POSTGRES_PORT=5432

# Local development database values. These defaults are not production secrets.
POSTGRES_DB=instrumenthub
POSTGRES_USER=instrumenthub
POSTGRES_PASSWORD=instrumenthub

# Optional SMTP notifications
# Optional. For local Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
SMTP_STARTTLS=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://instrumenthub:instrumenthub@localhost:5432/instrumenthub
DATABASE_ECHO=false

WEBSOCKET_MAX_CONNECTIONS=100
